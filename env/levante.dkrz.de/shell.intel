# Levante (DKRZ) — Intel toolchain. Anchor build for FESOM3 bit-identity.
# Module set proven on Levante (mirrors FESOM2 v2.7.3 / tracer_dwarf intel env).
export LC_ALL=en_US.UTF-8
export CPU_MODEL=AMD_EPYC_ZEN3

module --force purge

module load intel-oneapi-compilers/2022.0.1-gcc-11.2.0
module load openmpi/4.1.2-intel-2021.5.0
export FC=mpif90 CC=mpicc CXX=mpicxx

# netCDF (not needed until forcing/IO; loading only sets paths, harmless for M0)
module load netcdf-c/4.8.1-openmpi-4.1.2-intel-2021.5.0
module load netcdf-fortran/4.5.3-openmpi-4.1.2-intel-2021.5.0
module load git

ulimit -s unlimited 2>/dev/null || true   # netCDF wants a big stack; best-effort — on a SLURM
                                          # compute node the hard limit may already be capped
                                          # (e.g. batch `ulimit -s 204800`), and trying to RAISE it
                                          # errors. Under a caller's `set -e` that bare ulimit aborted
                                          # the whole gate (M8b dist_864). `|| true` keeps it benign;
                                          # the batch sets an explicit 204800 stack which netCDF accepts.
ulimit -c 0 2>/dev/null || true

# OpenMPI 4.x runtime settings for Levante
# https://docs.dkrz.de/doc/levante/running-jobs/runtime-settings.html
export OMPI_MCA_pml="ucx"
export OMPI_MCA_btl=self
export OMPI_MCA_osc="pt2pt"
export UCX_IB_ADDR_TYPE=ib_global
export OMPI_MCA_coll="^ml,hcoll"
export OMPI_MCA_coll_hcoll_enable="0"
export HCOLL_ENABLE_MCAST_ALL="0"
export HCOLL_MAIN_IB=mlx5_0:1
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self
export UCX_UNIFIED_MODE=y
export HDF5_USE_FILE_LOCKING=FALSE
export OMPI_MCA_io="romio321"
export UCX_HANDLE_ERRORS=bt
