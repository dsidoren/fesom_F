# Build artifacts
build/
build_*/
*.o
*.mod
*.smod
*.a
*.so
*.x

# External reference clones (cloned design docs / prior ports — not part of this repo)
design_refs/

# Manuscript draft (kept out of the code repo)
paper/

# Large ancillary artifacts
*.zip

# Python
__pycache__/
*.pyc

# Editor / OS
*.swp
*~
.DS_Store

# M8a runtime clock-state files (written by the clock machinery / gates)
*.clock

# SLURM job stdout (perf/A-B runs land here in the repo root — always artifacts)
slurm-*.out
